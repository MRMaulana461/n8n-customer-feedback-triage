    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Code in JavaScript').item.json;\nconst raw = ($json.text || \"\").replace(/```json|```/g, \"\").trim();\n\ntry {\n  const p = JSON.parse(raw);\n  return { json: {\n    id: original.id,\n    nama: original.nama,\n    pesan: original.pesan,\n    category: p.category,\n    sentiment: p.sentiment,\n    urgency: p.urgency,\n    summary: p.summary,\n    draft_reply: p.draft_reply,\n    parse_ok: true\n  }};\n} catch (e) {\n  return { json: {\n    id: original.id,\n    nama: original.nama,\n    pesan: original.pesan,\n    category: \"unknown\",\n    sentiment: \"unknown\",\n    urgency: \"medium\",\n    summary: \"\",\n    draft_reply: \"\",\n    parse_ok: false,\n    raw_output: raw\n  }};\n}"
      },
