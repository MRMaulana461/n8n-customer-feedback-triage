    {
      "parameters": {
        "jsCode": "const pesan = [\n  { id: 1, nama: \"Budi Santoso\", pesan: \"Mobil saya baru servis berkala kemarin, tapi pagi ini rem terasa blong dan lampu indikator ABS menyala. Tolong segera dicek, saya takut dipakai jalan.\" },\n  { id: 2, nama: \"Siti Rahma\", pesan: \"Saya mau tanya harga Avanza terbaru dan simulasi cicilan DP 20% tenor 5 tahun. Ada promo bulan ini?\" },\n  { id: 3, nama: \"Agus Wijaya\", pesan: \"Terima kasih mas Rudi di bagian service, pelayanannya cepat dan ramah. Mobil selesai lebih awal dari jadwal.\" },\n  { id: 4, nama: \"Dewi Lestari\", pesan: \"Sudah 3 minggu pesan Veloz tapi belum ada kabar kapan unitnya datang. Setiap ditelepon dijawab nanti dikabari. Kecewa sekali.\" },\n  { id: 5, nama: \"Rizky Pratama\", pesan: \"Apakah dealer buka hari Minggu? Saya mau test drive Innova Zenix.\" },\n  { id: 6, nama: \"Maya Putri\", pesan: \"AC mobil saya masih tidak dingin padahal sudah diservis dua kali untuk masalah yang sama. Biaya servisnya juga tidak murah.\" },\n  { id: 7, nama: \"Hendra Gunawan\", pesan: \"Mantap pelayanannya, salesnya menjelaskan detail dan tidak memaksa. Akhirnya saya ambil Yaris Cross.\" },\n  { id: 8, nama: \"Fitri Handayani\", pesan: \"Tolong kirim invoice servis tanggal 3 kemarin ke email saya, belum saya terima.\" },\n  { id: 9, nama: \"Doni Saputra\", pesan: \"Mesin mobil saya mati mendadak di tol setelah keluar dari bengkel kalian tadi siang. Sekarang saya menunggu derek. Mohon tanggung jawabnya!!\" },\n  { id: 10, nama: \"Lina Marlina\", pesan: \"Mau tanya, kalau trade-in Calya tahun 2018 harganya kira-kira berapa ya?\" },\n  { id: 11, nama: \"Taufik Hidayat\", pesan: \"Ruang tunggu bengkelnya bagus dan wifinya kencang, tapi kopinya kurang enak hehe. Overall puas.\" },\n  { id: 12, nama: \"Ratna Sari\", pesan: \"Saya dapat telepon dari nomor tidak dikenal mengaku dari dealer, minta transfer uang muka ke rekening pribadi. Apa ini benar?\" },\n  { id: 13, nama: \"Eko Prasetyo\", pesan: \"Servis 10.000 km kemarin kok biayanya Rp 1,8 juta? Sebelumnya cuma 900 ribu. Mohon rincian.\" },\n  { id: 14, nama: \"Anisa Rahmawati\", pesan: \"Halo, ada pilihan warna baru untuk Raize? Dan bisa indent online?\" },\n  { id: 15, nama: \"Joko Susilo\", pesan: \"Pelayanan lambat banget, nunggu 4 jam untuk servis ringan padahal sudah booking. Ga lagi deh.\" },\n  { id: 16, nama: \"Kevin Tanoto\", pesan: \"Thanks ya, tapi stiker di kaca belakang tolong diganti karena salah tempel. Selain itu bagus.\" },\n  { id: 17, nama: \"Wulan Sari\", pesan: \"asdfgh test\" },\n  { id: 18, nama: \"Bambang Irawan\", pesan: \"Mobil saya mengeluarkan bau bensin yang kuat setelah ganti fuel pump di bengkel kalian. Saya takut terjadi kebakaran, tolong dihubungi segera.\" }\n];\n\nreturn pesan.map(p => ({ json: p }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
