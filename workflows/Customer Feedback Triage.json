      ],
      "id": "12552a87-2893-4d28-8dbe-95d8e2f0551c",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Kamu adalah asisten customer service dealer mobil Toyota. Analisis pesan pelanggan berikut.\n\nPesan: {{ $json.pesan }}\n\nBalas HANYA dengan JSON valid, tanpa teks lain dan tanpa markdown, dengan format persis:\n{\"category\": \"...\", \"sentiment\": \"...\", \"urgency\": \"...\", \"summary\": \"...\", \"draft_reply\": \"...\"}\n\nAturan:\n- category: salah satu dari \"service_complaint\", \"sales_inquiry\", \"praise\", \"other\"\n- sentiment: \"positive\", \"neutral\", atau \"negative\"\n- urgency: \"low\", \"medium\", atau \"high\". Pakai \"high\" jika ada risiko keselamatan, indikasi penipuan, atau pelanggan sangat marah.\n- summary: satu kalimat bahasa Indonesia\n- draft_reply: balasan sopan 2-3 kalimat bahasa Indonesia",
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 20000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        624,
        0
      ],
      "id": "9c21509c-b84c-4117-beb7-755678a36343",
      "name": "Basic LLM Chain",
      "retryOnFail": true,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "model": "=openai/gpt-oss-20b",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
